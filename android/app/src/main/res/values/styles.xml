<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — Fit Log is dark-tinted by design (src/styles.css tokens). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fitlog_primary</item>
        <item name="colorPrimaryDark">@color/fitlog_background</item>
        <item name="colorAccent">@color/fitlog_run</item>
        <item name="android:windowBackground">@color/fitlog_background</item>
        <item name="android:statusBarColor">@color/fitlog_background</item>
        <item name="android:navigationBarColor">@color/fitlog_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Launch theme: system splash (Android 12+) with the app mark on the app background. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fitlog_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/fitlog_background</item>
        <item name="android:navigationBarColor">@color/fitlog_background</item>
    </style>
</resources>
